@article{ Bai_2021,
Author = {Bai, Jingwen and Bandla, Chakradhar and Guo, Jiaxin and Alvarez, Roberto
   Vera and Bai, Mingze and Vizcaino, Juan Antonio and Moreno, Pablo and
   Gruening, Bjoern and Sallou, Olivier and Perez-Riverol, Yasset},
Title = {BioContainers Registry: Searching Bioinformatics and Proteomics Tools,
   Packages, and Containers},
Journal = {Journal of Proteome Research},
Year = {2021},
Volume = {20},
Number = {4, SI},
Pages = {2056-2061},
Month = {APR 2},
Abstract = {BioContainers is an open-source project that aims to create, store, and
   distribute bioinformatics software containers and packages. The
   BioContainers community has developed a set of guidelines to standardize
   software containers including the metadata, versions, licenses, and
   software dependencies. Bio-Containers supports multiple packaging and
   container technologies such as Conda, Docker, and Singularity. The
   BioContainers provide over 9000 bioinformatics tools, including more
   than 200 proteomics and mass spectrometry tools. Here we introduce the
   BioContainers Registry and Restful API to make containerized
   bioinformatics tools more findable, accessible, interoperable, and
   reusable (FAIR). The BioContainers Registry provides a fast and
   convenient way to find and retrieve bioinformatics tool packages and
   containers. By doing so, it will increase the use of bioinformatics
   packages and containers while promoting replicability and
   reproducibility in research.},

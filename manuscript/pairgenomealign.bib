   and Rasche, Eric and Soranzo, Nicola and Turaga, Nitesh and Taylor,
   James and Nekrutenko, Anton and Goecks, Jeremy},
Title = {The Galaxy platform for accessible, reproducible and collaborative
   biomedical analyses: 2016 update},

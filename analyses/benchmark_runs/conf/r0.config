/*
 * R0: the LAST run behind Fig. 1B of Gulhan et al. (2025) Genome Biology 26:389,
 * reproduced inside nf-core/pairgenomealign 3.0.4 with LAST 1608.
 *
 * Commands reproduced (https://github.com/nekrut/lz-fg-mm, README):
 *   lastdb     -P24 -uRY128 humdb hg38.fa.gz
 *   last-train -P24 --revsym -C2 humdb mm39.fa.gz > hm.train
 *   lastal     -P24 -C2 -f BlastTab -p hm.train humdb mm39.fa.gz > hm.tab
 *
 * Remaining differences, none of which changes the set of alignments:
 *   - output is MAF (alignment/hg38___mm39.m2m.maf.gz) instead of BlastTab;
 *   - -P comes from task.cpus instead of 24, which changes output order only.
 *
 * Loaded by bin/02_run.sh for the run named "r0", after conf/deigo-executor.config,
 * together with params/r0.yaml.
 *
 * params.softmask and params.strand still appear in params.json, but have no effect:
 * the ext.args of ALIGNMENT_LASTDB is replaced below.
 */

process {

    // LAST 1608 image, as pinned in nf-core/modules commit b651d7202 (2025-01-22).
    // Docker equivalent: community.wave.seqera.io/library/last:1608--f41c047f7dc37e30
    withName: 'ALIGNMENT_LASTDB|ALIGNMENT_TRAIN|ALIGNMENT_LASTAL_M2M' {
        container = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/db/db0b5de918238f07ec1ca668be942397da85e26aa582f8927ac37c70896303cf/data'
    }

    // Pipeline default: -R01 -c -U400 -u<seed> -S2
    // R0: seed only; no -c, so no soft-masking; forward strand only (lastdb default).
    withName: 'ALIGNMENT_LASTDB' {
        ext.args = '-uRY128'
    }

    // Pipeline default: -Qfastx --revsym --gapsym --matsym <lastal_args>
    withName: 'ALIGNMENT_TRAIN' {
        ext.args = '--revsym -C2'
    }

    // Pipeline default: <lastal_args> = -C2 -D1e9
    // R0: -C2 only, so lastal's default -D applies.
    withName: 'ALIGNMENT_LASTAL_M2M' {
        ext.args = '-C2'
    }

    // R0 has no last-split step. Skipping M2O and O2M leaves O2O and the
    // corresponding dot plots without input, so they do not run either.
    withName: 'ALIGNMENT_SPLIT_.*' {
        ext.when = false
    }
}

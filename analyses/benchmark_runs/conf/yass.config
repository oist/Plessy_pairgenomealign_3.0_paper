/*
 * yass: as conf/near.config. In the benchmark of Figure 4, YASS used about as
 * much time and memory as NEAR, so the splitting steps get the memory that
 * conf/near.config gives them. Loaded by bin/02_run.sh for the run named "yass".
 */
process {
    withName: 'ALIGNMENT_SPLIT_O2M|ALIGNMENT_SPLIT_M2O' {
        memory = 500.GB
    }
}

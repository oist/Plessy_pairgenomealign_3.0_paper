// Slurm throttling and the unit image cache for Deigo (from the oist-hpc-nextflow skill).
// Use together with -profile oist, which sets Singularity, executor slurm,
// queue compute, -C zen2 and resourceLimits.

executor {
    queueSize         = 200
    pollInterval      = '30s'
    submitRateLimit   = '1/10s'
    queueStatInterval = '5min'
}

// Real path: Nextflow does not find images through the /apps/unit symlink.
singularity.cacheDir = '/hpcshare/appsunit/LuscombeU/singularity.cacheDir/'

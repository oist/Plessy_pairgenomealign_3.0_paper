/*
 * mam8: pipeline 3.0.4 defaults with seed MAM8 (params/mam8.yaml) and raised
 * resources for the LAST steps. Loaded by bin/02_run.sh for the run named "mam8".
 *
 * MAM8 indexes the target with 8 seed patterns, so the index, and the memory of
 * each step that loads it (lastdb, last-train, lastal), are several times larger
 * than with a single-pattern seed. Conservative values, to be revised from the
 * execution trace.
 *
 * 500 GB is the most that fits one standard Deigo node (512000 MB); 96 h is the
 * time limit of the compute partition. The oist profile caps time at 90 h,
 * hence the resourceLimits line.
 */

process {
    resourceLimits = [ cpus: 128, memory: 500.GB, time: 96.h ]

    // Steps that load the index. 500 GB reserves a whole node, so all its cores
    // are requested as well; the thread count changes the output order only.
    withName: 'ALIGNMENT_LASTDB|ALIGNMENT_TRAIN|ALIGNMENT_LASTAL_.*' {
        cpus   = 128
        memory = 500.GB
        time   = 96.h
    }

    // last-split runs on one thread.
    withName: 'ALIGNMENT_SPLIT_.*' {
        memory = 500.GB
        time   = 96.h
    }
}
